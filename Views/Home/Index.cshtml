@{
    ViewData["Title"] = "首页";
}
@model HomeViewModel

<section>
    <h1>@Model.Greeting，我是 Keyan</h1>
    <p>一名计算机专业大学生，在这里记录学习、项目和生活。</p>

    <h2>这个网站</h2>
    <p>这是我用 ASP.NET Core 搭建的个人网站，也是学习 Web 开发的实践项目。</p>

    <h2>我正在做什么</h2>
    <ul>
        @foreach (var activity in @Model.Activities)
        {
            <li>@activity</li>
        }
    </ul>
</section>
