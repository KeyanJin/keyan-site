@model HomeViewModel

@{
    ViewData["Title"] = "首页";
}

<section class="space-y-8">
    <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
            @Model.Greeting，我是 Keyan
        </h1>
        <p class="mt-4 leading-relaxed text-slate-600">
            一名计算机专业大学生，在这里记录学习、项目和生活。
        </p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold">这个网站</h2>
        <p class="mt-3 leading-relaxed text-slate-600">
            这是我用 ASP.NET Core 搭建的个人网站，也是学习 Web 开发的实践项目。
        </p>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold">我正在做什么</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-slate-600">
            @foreach (var activity in Model.Activities)
            {
                <li>@activity</li>
            }
        </ul>
    </div>
</section>