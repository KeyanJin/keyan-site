<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Keyan's Site</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body class="flex min-h-screen flex-col bg-slate-50 text-slate-800">
<header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-4 px-6 py-4"
         aria-label="主导航">
        <a class="text-xl font-bold"
           asp-controller="Home" asp-action="Index">Keyan</a>

        <ul class="flex gap-6">
            <li>
                <a class="hover:text-blue-600"
                   asp-controller="Home" asp-action="Index">首页</a>
            </li>
            <li>
                <a class="hover:text-blue-600"
                   asp-controller="Home" asp-action="About">关于我</a>
            </li>
            <li>
                <a class="hover:text-blue-600"
                   asp-controller="Home" asp-action="Privacy">隐私</a>
            </li>
        </ul>
    </nav>
</header>

<main class="mx-auto w-full max-w-4xl flex-1 px-6 py-10">
    @RenderBody()
</main>

<footer class="border-t border-slate-200 px-6 py-6 text-center text-sm text-slate-500">
    &copy; @DateTime.Now.Year - Keyan
</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>